ggplot() +
# Grade
geom_sf(
data = grid_utm,
fill = NA,
color = "grey",
linewidth = 0.25
) +
# Município
geom_sf(
data = municipio_sa,
aes(fill = "Município"),
color = "grey50",
linewidth = 0.4
) +
# Ecopontos
geom_sf(
data = ecopontos,
aes(color = "Estações de Coleta"),
size = 1.6
) +
scale_fill_manual(
values = c("Município" = "grey90"),
name = " "
) +
scale_color_manual(
values = c("Estações de Coleta" = "#2F6F4E"),
name = "Legenda"
) +
guides(
fill = guide_legend(override.aes = list(color = "grey50")),
color = guide_legend(override.aes = list(size = 3))
) +
# Rótulos
geom_text(
data = labels_x_df,
aes(x = x, y = y, label = label),
size = 2
) +
geom_text(
data = labels_y_df,
aes(x = x, y = y, label = label),
size = 2
) +
# Projeção
coord_sf(
crs = 31983,
datum = NA
) +
# Escala
annotation_scale(
location = "bl",
width_hint = 0.25
) +
# Norte
annotation_north_arrow(
location = "tr",
style = north_arrow_fancy_orienteering()
) +
labs(
title = "Distribuição das Estações de Coleta em Santo André (SP)",
caption = "Fonte: SEMASA (2020); IBGE (2020)\nElaboração: Autores (2026)\nProjeção: SIRGAS 2000 / UTM zona 23S"
) +
theme_minimal() +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold", hjust = 0.5),
axis.text = element_blank(),
axis.title = element_blank(),
panel.grid = element_blank()
)
